@page "/"

<div class="header-hero">
    <img src="images/logo.jpeg" alt="Carito Nails Studio" class="hero-logo" />
    <h1>CARITO NAILS</h1>
    <p class="subtitle">Estudio & Spa de Uñas</p>
</div>

<h2 style="font-family: 'Cormorant Garamond', serif; font-size: 2.2rem; text-align: center; margin-bottom: 10px;">
    Nuestros Servicios Exclusivos
</h2>
<p style="text-align: center; color: var(--text-muted); margin-bottom: 30px;">
    Elige la experiencia perfecta para el cuidado y estilo de tus manos.
</p>

<div class="catalog-grid">
    <div class="neon-card gold-style">
        <h3 class="service-title">Manicura Rusa</h3>
        <div class="service-price">S/ 50.00</div>
        <p class="service-desc">Limpieza profunda de cutículas con torno y esmaltado semipermanente de alta duración.</p>
        <a href="reservar" class="btn-neon">Reservar Cita</a>
    </div>

    <div class="neon-card">
        <h3 class="service-title">Soft Gel / Acrílicas</h3>
        <div class="service-price">S/ 90.00</div>
        <p class="service-desc">Extensión de uñas con sistema ligero, resistente y acabado natural de lujo.</p>
        <a href="reservar" class="btn-neon">Reservar Cita</a>
    </div>

    <div class="neon-card gold-style">
        <h3 class="service-title">Nail Art Personalizado</h3>
        <div class="service-price">S/ 110.00</div>
        <p class="service-desc">Diseños a mano alzada, efectos encapsulados, cristales y tendencias de catálogo.</p>
        <a href="reservar" class="btn-neon">Reservar Cita</a>
    </div>

    <div class="neon-card">
        <h3 class="service-title">Pedicura Spa</h3>
        <div class="service-price">S/ 65.00</div>
        <p class="service-desc">Tratamiento hidratante completo, exfoliación, masaje y esmaltado de larga duración.</p>
        <a href="reservar" class="btn-neon">Reservar Cita</a>
    </div>
</div>